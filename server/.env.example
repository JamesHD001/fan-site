PORT=5000
NODE_ENV=development

MONGODB_URI=
MONGODB_DB_NAME=keanu_reeves_fan_community

JWT_SECRET=your_jwt_secret_here

# Existing Paystack integration (keep until Flutterwave migration is complete)
PAYSTACK_SECRET_KEY=your_paystack_secret_key_here
PAYSTACK_PUBLIC_KEY=your_paystack_public_key_here

# Flutterwave test/live credentials
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=

# Secret hash configured for Flutterwave webhooks
FLUTTERWAVE_WEBHOOK_SECRET_HASH=

CLIENT_URL=http://localhost:5173

# Transactional email / OTP delivery (Resend)
RESEND_API_KEY=
EMAIL_FROM=Keanu Reeves Fan Community <noreply@your-verified-domain.com>

# Required for database seeding
ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace_with_a_strong_password
