PORT=5000
NODE_ENV=development

MONGODB_URI=
MONGODB_DB_NAME=keanu_reeves_fan_community
JWT_SECRET=your_jwt_secret_here
CLIENT_URL=http://localhost:5173

# Transactional email / OTP delivery (Resend)
RESEND_API_KEY=
EMAIL_FROM=Celeb_Name_Fan_Community<noreply@your-verified-domain.com>

# Cloudinary signed image uploads for community posts
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Required for database seeding
ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace_with_a_strong_password
